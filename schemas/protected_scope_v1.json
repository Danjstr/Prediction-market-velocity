{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pmv.protected_scope_registry/1",
  "title": "PMV protected-scope registry, version 1",
  "description": "The canonical JSON file research/protected_scopes/registry.v1.json (one line, one trailing newline). Documentation only: the authoritative validator is pmv.protected_scope.parse_registry / validate_scope, which also enforces the cross-field rules described here: scope_ids are unique; a non-null supersedes names an EARLIER scope by its exact canonical SHA-256; no scope has two successors; and a successor may only widen its predecessor (same cycle_id, same holdout_id unless the predecessor's was null, start no later, end no earlier or null, margin and every resolution lag no smaller, venues and contracts supersets). Scopes are metadata only: never values, labels, outcomes, or prices. Canonical bytes: sorted keys, no spaces, ASCII, no floats; JSON booleans are never integers. Git history must show every committed registry as a scope-prefix of every later one (pmv.protected_scope.verify_registry_history).",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
      "description": "UTC; must be a real calendar time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "venue": {
      "enum": ["kalshi", "polymarket"]
    },
    "observable": {
      "enum": ["btc_usd_price", "xau_usd_price"]
    },
    "kalshi_ticker": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]{0,127}$"
    },
    "decimal_id": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,77})$",
      "description": "Decimal, no leading zeros"
    },
    "non_negative_integer": {
      "type": "integer",
      "minimum": 0
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attestation",
        "contracts",
        "cycle_id",
        "declared_at",
        "holdout_id",
        "margin_seconds",
        "observables",
        "protected_interval",
        "scope_id",
        "split_definition",
        "supersedes",
        "venues"
      ],
      "properties": {
        "attestation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attested", "role"],
          "properties": {
            "attested": {"const": true},
            "role": {"const": "project_owner"}
          }
        },
        "contracts": {
          "type": "array",
          "description": "Protected contracts, one record per canonical identity (Kalshi market_ticker, Polymarket condition_id), sorted by canonical JSON. Every identifier is ASCII and stored in its normalized spelling (pmv.protected_scope.normalize_identifier); lists are sorted, unique, and complete. Relationships are explicit: an event or series reaches a contract only if the record lists it. A protected contract is refused under every semantics at every time. Only slugs may be empty; an empty slug list makes any slug request fail closed. Successors keep every record and every identifier; lists may only gain values.",
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["event_ticker", "market_ticker", "series_ticker", "venue"],
                "properties": {
                  "event_ticker": {"$ref": "#/$defs/kalshi_ticker"},
                  "market_ticker": {"$ref": "#/$defs/kalshi_ticker"},
                  "series_ticker": {"$ref": "#/$defs/kalshi_ticker"},
                  "venue": {"const": "kalshi"}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["condition_id", "event_ids", "market_id", "slugs", "token_ids", "venue"],
                "properties": {
                  "condition_id": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"},
                  "event_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/decimal_id"}},
                  "market_id": {"$ref": "#/$defs/decimal_id"},
                  "slugs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]{1,100}(-[a-z0-9]{1,100}){0,30}$"}},
                  "token_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/decimal_id"}},
                  "venue": {"const": "polymarket"}
                }
              }
            ]
          }
        },
        "cycle_id": {"$ref": "#/$defs/identifier"},
        "declared_at": {"$ref": "#/$defs/timestamp"},
        "holdout_id": {"oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "margin_seconds": {
          "$ref": "#/$defs/non_negative_integer",
          "description": "Required and explicit; there is no default margin."
        },
        "observables": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Sorted by observable, unique.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["observable", "resolution_lag_seconds"],
            "properties": {
              "observable": {"$ref": "#/$defs/observable"},
              "resolution_lag_seconds": {"$ref": "#/$defs/non_negative_integer"}
            }
          }
        },
        "protected_interval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["end", "start"],
          "description": "Half-open UTC [start, end); end null means open-ended (prospective). The guard protects [start - margin, end + margin + lag).",
          "properties": {
            "end": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
            "start": {"$ref": "#/$defs/timestamp"}
          }
        },
        "scope_id": {"$ref": "#/$defs/identifier"},
        "split_definition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"type": "string", "pattern": "^research/splits/[a-z][a-z0-9_]{0,63}\\.yaml$"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "supersedes": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["scope_id", "scope_sha256"],
              "properties": {
                "scope_id": {"$ref": "#/$defs/identifier"},
                "scope_sha256": {"$ref": "#/$defs/sha256"}
              }
            }
          ]
        },
        "venues": {
          "type": "array",
          "uniqueItems": true,
          "description": "Sorted, unique.",
          "items": {"$ref": "#/$defs/venue"}
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "scopes"],
  "properties": {
    "schema": {"const": "pmv.protected_scope_registry"},
    "schema_version": {"const": 1},
    "scopes": {"type": "array", "items": {"$ref": "#/$defs/scope"}}
  }
}
