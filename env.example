# env.example: NON-SECRET TEMPLATE. Contains environment variable NAMES only, never values.
#
# Never put a real value in this file, and never store real secrets in this repository.
# Do not copy this file to .env inside the repository. Real secret values are supplied
# at runtime from storage outside the repository and outside development-agent access.

# Configuration selector (not a secret): development, test, shadow, or production.
PMV_ENV=

# Secret inputs (PMV_SECRET_*): none are defined yet. Each is added here, name only,
# when the integration that needs it is built from verified official documentation.
