{
  "permissions": {
    "deny": [
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/*.key)",
      "Read(**/*.p12)",
      "Edit(**/*.p12)",
      "Read(**/*.pfx)",
      "Edit(**/*.pfx)",
      "Read(secrets/**)",
      "Edit(secrets/**)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/pmv-protected/**)",
      "Edit(~/pmv-protected/**)",
      "Read(~/pmv-credentials/**)",
      "Edit(~/pmv-credentials/**)",
      "WebFetch(domain:api.*)",
      "WebFetch(domain:api.*.*)",
      "WebFetch(domain:api.*.*.*)",
      "WebFetch(domain:*-api.*)",
      "WebFetch(domain:*-api.*.*)",
      "WebFetch(domain:*-api.*.*.*)",
      "WebFetch(domain:clob.*)",
      "WebFetch(domain:clob.*.*)",
      "WebFetch(domain:clob.*.*.*)",
      "WebFetch(domain:ws.*)",
      "WebFetch(domain:ws.*.*)",
      "WebFetch(domain:ws.*.*.*)",
      "WebFetch(domain:ws-*.*)",
      "WebFetch(domain:ws-*.*.*)",
      "WebFetch(domain:ws-*.*.*.*)",
      "WebFetch(domain:stream.*)",
      "WebFetch(domain:stream.*.*)",
      "WebFetch(domain:stream.*.*.*)",
      "WebFetch(domain:rpc.*)",
      "WebFetch(domain:rpc.*.*)",
      "WebFetch(domain:rpc.*.*.*)",
      "WebFetch(domain:*-rpc.*)",
      "WebFetch(domain:*-rpc.*.*)",
      "WebFetch(domain:*-rpc.*.*.*)",
      "WebFetch(domain:kalshi.com)",
      "WebFetch(domain:www.kalshi.com)",
      "WebFetch(domain:api.elections.kalshi.com)",
      "WebFetch(domain:trading-api.kalshi.com)",
      "WebFetch(domain:demo-api.kalshi.co)",
      "WebFetch(domain:polymarket.com)",
      "WebFetch(domain:www.polymarket.com)",
      "WebFetch(domain:clob.polymarket.com)",
      "WebFetch(domain:gamma-api.polymarket.com)",
      "WebFetch(domain:data-api.polymarket.com)",
      "WebFetch(domain:api.exchange.bullish.com)",
      "WebFetch(domain:data.chain.link)",
      "WebFetch(domain:pythdata.app)",
      "WebFetch(domain:*.pythdata.app)",
      "WebFetch(domain:hermes.pyth.network)",
      "WebFetch(domain:polygonscan.com)",
      "WebFetch(domain:*.polygonscan.com)",
      "WebFetch(domain:degenhedge.com)",
      "WebFetch(domain:*.degenhedge.com)",
      "WebFetch(domain:predictionmarketspicks.com)",
      "WebFetch(domain:*.predictionmarketspicks.com)",
      "WebFetch(domain:cfbenchmarks.com)",
      "WebFetch(domain:*.cfbenchmarks.com)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~/pmv-protected",
        "~/pmv-credentials"
      ],
      "denyWrite": [
        "~/pmv-protected",
        "~/pmv-credentials"
      ]
    }
  }
}
